# İlkem Derneği - Apache / LiteSpeed (Hostinger) yapılandırması
AddDefaultCharset UTF-8
DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS'e yönlendirme isterseniz aşağıdaki iki satırın başındaki # işaretini kaldırın
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Uygulama klasörlerine ve gizli dosyalara doğrudan erişimi engelle
    RewriteRule ^(app|config|database|templates|bin|admin/views)(/|$) - [F,L]
    RewriteRule ^admin/(lib|resources)\.php$ - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg)$ - [F,L,NC]

    # Var olan dosya ve klasörler doğrudan sunulur
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Diğer tüm istekler ön yüz yönlendiricisine
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Hassas dosya türleri
<FilesMatch "\.(sql|md|log|ini|sh|bak|example\.php|lock|json|dist)$">
    Require all denied
</FilesMatch>
<FilesMatch "^dev-router\.php$">
    Require all denied
</FilesMatch>

ErrorDocument 403 "Erisim engellendi."

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
